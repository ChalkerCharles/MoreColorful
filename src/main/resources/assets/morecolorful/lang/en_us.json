  "morecolorful.config.block": "Block",
  "morecolorful.config.block.tooltip": "Configs about blocks.",
  "morecolorful.config.thermal_system": "Thermal System",
  "morecolorful.config.thermal_system.tooltip": "Introduce thermal system for blocks. Now each block has a temperature level, and the temperature level will decrease while spreading.\nIce and snow only melt when the temperature is high enough, instead of depending on light level.\nThe conduction of heat will be affected by block's thermal resistance.",
  "morecolorful.config.block_temperature": "Block Temperature",
  "morecolorful.config.block_temperature.tooltip":"Define a proper temperature value (Range: 0-15) for blocks with certain block state. Or you can also override the More Colorful configs. Block states are optional.\nFormat: \"<block name>[block states]=<value>\". Example: \"minecraft:sea_lantern=0\", \"minecraft:redstone_lamp[lit=true]=12\"",
  "morecolorful.config.thermal_resistance": "Thermal Resistance",
  "morecolorful.config.thermal_resistance.tooltip": "Define a proper thermal resistance value (Range: 1-15) for blocks with certain block state, by default the value is 3. Or you can also override the More Colorful configs. Block states are optional.\nFormat: \"<block name>[block states]=<value>\". Example: \"minecraft:stone=3\", \"minecraft:oak_fence[waterlogged=true]=4\"",
  "morecolorful.config.loot": "Loot",
  "morecolorful.config.loot.tooltip": "Configs about loots.",
  "morecolorful.config.archaeology_loots": "Archaeology Loots",
  "morecolorful.config.archaeology_loots.tooltip": "Add new loots in suspicious blocks, and you can get them by archaeology.",
  "morecolorful.config.world": "World",
  "morecolorful.config.world.tooltip": "Configs about world.",
  "morecolorful.config.wind_system": "Wind System",
  "morecolorful.config.wind_system.tooltip": "Wind is a global weather occurrence that randomly happens. The wind consists of two components on X axis and Z axis, and the max speed of each component is 17.5 (m/s).",
  "morecolorful.config.wind_physics": "Wind Physics",
  "morecolorful.config.wind_physics.tooltip": "Allow wind to push entities.",
  "morecolorful.config.wind_aiding_fire_spread": "Wind Aiding Fire Spread",
  "morecolorful.config.wind_aiding_fire_spread.tooltip": "Wind can assist the fire spreading downwind.",
  "morecolorful.config.windless_dimensions": "Windless Dimensions",
  "morecolorful.config.windless_dimensions.tooltip": "Wind won't blow in dimensions in this list.",
  "morecolorful.config.world.generation": "World Generation",
  "morecolorful.config.world.generation.tooltip": "Configs about world generation.",
  "morecolorful.config.overworld_region_weight": "Overworld Region Weight",
  "morecolorful.config.overworld_region_weight.tooltip": "The weight of More Colorful Biome regions in the overworld. Set to 0 to disable it.",
  "morecolorful.config.disabled_biomes": "Disabled Biomes",
  "morecolorful.config.disabled_biomes.tooltip": "A list of biomes that are disabled from world generation.",
